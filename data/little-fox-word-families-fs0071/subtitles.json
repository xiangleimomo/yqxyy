    {
      "episodeId": "C0006157",
      "title": "Pug Can Tug",
      "subtitle": [
        {
          "startMs": 3357,
          "endMs": 11803,
          "text": "/u, g/ /u-g/ /ug/",
          "highlight": []
        },
        {
          "startMs": 12029,
          "endMs": 25025,
          "text": "/r, u, g/ /r-ug/ /rug/",
          "highlight": []
        },
        {
          "startMs": 25347,
          "endMs": 37565,
          "text": "/b, u, g/ /b-ug/ /bug/",
          "highlight": []
        },
        {
          "startMs": 37807,
          "endMs": 50090,
          "text": "/t, u, g/ /t-ug/ /tug/",
          "highlight": []
        },
        {
          "startMs": 50427,
          "endMs": 64328,
          "text": "/h, u, g/ /h-ug/ /hug/",
          "highlight": []
        },
        {
          "startMs": 68267,
          "endMs": 71566,
          "text": "Pug is my dog.",
          "highlight": []
        },
        {
          "startMs": 75810,
          "endMs": 78749,
          "text": "Pug can tug.",
          "highlight": []
        },
        {
          "startMs": 81699,
          "endMs": 85194,
          "text": "He can tug on a rug.",
          "highlight": []
        },
        {
          "startMs": 86098,
          "endMs": 89168,
          "text": "Pug can jog.",
          "highlight": []
        },
        {
          "startMs": 92864,
          "endMs": 96067,
          "text": "He can jog to a mug.",
          "highlight": []
        },
        {
          "startMs": 97227,
          "endMs": 99660,
          "text": "Pug can jump.",
          "highlight": []
        },
        {
          "startMs": 101944,
          "endMs": 105534,
          "text": "He can jump over a bug.",
          "highlight": []
        },
        {
          "startMs": 109460,
          "endMs": 112371,
          "text": "Pug can beg.",
          "highlight": []
        },
        {
          "startMs": 118729,
          "endMs": 122196,
          "text": "He can beg for some ham.",
          "highlight": []
        },
        {
          "startMs": 125450,
          "endMs": 127558,
          "text": "Pug can sit.",
          "highlight": []
        },
        {
          "startMs": 129515,
          "endMs": 132950,
          "text": "He can sit on the rug.",
          "highlight": []
        },
        {
          "startMs": 133061,
          "endMs": 136079,
          "text": "Pug is my dog.",
          "highlight": []
        },
        {
          "startMs": 136639,
          "endMs": 139097,
          "text": "He is a good pet.",
          "highlight": []
        },
        {
          "startMs": 145519,
          "endMs": 148115,
          "text": "I hug him a lot.",
          "highlight": []
        }
      ]
    },
    {
      "episodeId": "C0006158",
      "title": "A Cut and a Nut",
      "subtitle": [
        {
          "startMs": 3548,
          "endMs": 11790,
          "text": "1",
          "highlight": []
        },
        {
          "startMs": 12056,
          "endMs": 24382,
          "text": "2",
          "highlight": []
        },
        {
          "startMs": 24592,
          "endMs": 36925,
          "text": "3",
          "highlight": []
        },
        {
          "startMs": 37263,
          "endMs": 50913,
          "text": "4",
          "highlight": []
        },
        {
          "startMs": 55769,
          "endMs": 60531,
          "text": "\"I see a nut!\" said Hun.",
          "highlight": []
        },
        {
          "startMs": 64540,
          "endMs": 67900,
          "text": "Hun ran fast to the nut.",
          "highlight": []
        },
        {
          "startMs": 68961,
          "endMs": 72220,
          "text": "But Ted did not run fast.",
          "highlight": []
        },
        {
          "startMs": 72917,
          "endMs": 76070,
          "text": "Ted fell.",
          "highlight": []
        },
        {
          "startMs": 78209,
          "endMs": 81949,
          "text": "\"I have a cut!\" Ted said.",
          "highlight": []
        },
        {
          "startMs": 84154,
          "endMs": 87065,
          "text": "\"My leg is red!\"",
          "highlight": []
        },
        {
          "startMs": 88289,
          "endMs": 92206,
          "text": "\"There is a hut,\" said Hun.",
          "highlight": []
        },
        {
          "startMs": 102165,
          "endMs": 106327,
          "text": "\"My cut is bad,\" said Ted.",
          "highlight": []
        },
        {
          "startMs": 107226,
          "endMs": 110504,
          "text": "\"We cannot run.\"",
          "highlight": []
        },
        {
          "startMs": 111797,
          "endMs": 114084,
          "text": "Ted was sad.",
          "highlight": []
        },
        {
          "startMs": 114792,
          "endMs": 117912,
          "text": "But Hun was not sad.",
          "highlight": []
        },
        {
          "startMs": 118908,
          "endMs": 121888,
          "text": "\"Here, Ted,\" said Hun.",
          "highlight": []
        },
        {
          "startMs": 122302,
          "endMs": 124897,
          "text": "\"Here is a nut!\"",
          "highlight": []
        }
