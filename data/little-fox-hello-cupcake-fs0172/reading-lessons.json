{
  "1": {
    "episodeId": 1,
    "title": "A New Friend",
    "source": "official-text",
    "sourceId": "C0012330",
    "paragraphs": [
      {
        "id": "p1",
        "text": "It was a bright morning.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "The kitchen was quiet.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "The oven door opened.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Cupcake popped out!",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "Cupcake jumped onto the kitchen counter.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Her icing sparkled.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "\"Hello, world!\" she said.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Cupcake danced around.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "She tapped her feet.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "She waved her hands.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "Cupcake danced by a box.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "\"Hello, box!\" she sang. \"Hello, plate!\"",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "She danced by the sink.",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "\"Hello, sponge! Hello, dish soap!\"",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "Cupcake danced by a cup.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "A blueberry sat on the rim.",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "\"Oh, hello!\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "\"I'm Cupcake!\"",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "The blueberry smiled.",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "\"Hello, Cupcake. I'm Berry.\"",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "Cupcake danced past the cup.",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "She did kicks.",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "Her foot hit the cup.",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "\"Whoa!\" Berry fell.",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "He rolled toward the counter's edge.",
        "translation": ""
      },
      {
        "id": "p26",
        "text": "\"Help!\"",
        "translation": ""
      }
    ]
  },
  "2": {
    "episodeId": 2,
    "title": "Best Friends",
    "source": "official-text",
    "sourceId": "C0012331",
    "paragraphs": [
      {
        "id": "p1",
        "text": "\"Uh-oh!\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Berry was rolling.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "He was close to the edge!",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Cupcake ran fast.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "\"I'll catch you!\"",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Cupcake caught Berry.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "\"Whew!\" she said.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "\"You saved me!\" Berry said.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "He smiled. \"Thank you!\"",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "Cupcake smiled too.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "\"Do you like to dance?\"",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "\"I love to dance!\" Berry said.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "\"I like to sing,\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "Berry grinned. \"Me too!",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "And sometimes I like to roll!\"",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "\"I like to roll too!\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "\"And jump up and down!\"",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "Berry jumped up and down. \"Me too!\"",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "\"Wow! This is great!\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "She jumped up and down.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "\"We like all the same things!\"",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "\"Yeah!\" Berry said.",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "\"We can be friends!\"",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "Cupcake did a big jump.",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "\"Woo-hoo!\"",
        "translation": ""
      },
      {
        "id": "p26",
        "text": "Icing flew all over.",
        "translation": ""
      },
      {
        "id": "p27",
        "text": "\"Hey!\" a voice said.",
        "translation": ""
      },
      {
        "id": "p28",
        "text": "\"Who threw that?\"",
        "translation": ""
      }
    ]
  },
  "3": {
    "episodeId": 3,
    "title": "Let's Dance!",
    "source": "official-text",
    "sourceId": "C0012332",
    "paragraphs": [
      {
        "id": "p1",
        "text": "A vegetable was reading a book.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Icing was on his face.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "Berry smiled. \"Hi, Bok Choy!",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "This is Cupcake.\"",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "\"Hello, Cupcake,\" Bok Choy said.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "\"It's nice to meet you.\"",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "Bok Choy got a tissue.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "He wiped off his face.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "\"Do you want to dance?\" Cupcake asked.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "\"No, thanks,\" Bok Choy said.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "\"Bok Choy doesn't dance,\" Berry said.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "Cupcake and Berry danced.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "Bok Choy read his book.",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "Splat! Icing hit the wall.",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "Bok Choy looked up.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "\"You're making a mess!\"",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "\"We'll clean up later,\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "She and Berry danced some more.",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "Bok Choy sighed.",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "He read more of his book.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "Bok Choy's foot began to tap—just a little bit.",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "Suddenly Berry slipped. \"Whoa!\"",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "He bumped into Cupcake.",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "\"Ahh!\" Cupcake went flying.",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "Sploosh!",
        "translation": ""
      },
      {
        "id": "p26",
        "text": "She landed on Bok Choy.",
        "translation": ""
      }
    ]
  },
  "4": {
    "episodeId": 4,
    "title": "A Big Mess",
    "source": "official-text",
    "sourceId": "C0012333",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Cupcake was on Bok Choy.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Her icing made a big mess!",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "\"I'm sorry,\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Bok Choy sighed.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "Bok Choy took a shower.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Soon he was clean.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "The kitchen was not.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Cupcake and Berry kept playing.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "\"Time to clean up,\" Bok Choy said.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "Cupcake laughed. \"That's not fun!\"",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "Bok Choy got a mop.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "\"Let's ask Bok Choy to play,\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "\"He's cleaning,\" Berry said.",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "\"Huh?\" Cupcake looked.",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "Bok Choy was working hard.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "Cupcake went over to him.",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "\"That doesn't look fun.\"",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "\"It's not fun,\" Bok Choy said.",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "\"But it must be done.\"",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "Cupcake felt bad.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "\"We'll help,\" she said.",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "\"Then it's fun time.\"",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "The three friends cleaned.",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "Soon the kitchen sparkled.",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "\"Is it fun time now?\" Cupcake asked.",
        "translation": ""
      },
      {
        "id": "p26",
        "text": "\"Yes.\" Bok Choy nodded.",
        "translation": ""
      },
      {
        "id": "p27",
        "text": "Bok Choy started reading.",
        "translation": ""
      },
      {
        "id": "p28",
        "text": "Cupcake and Berry danced.",
        "translation": ""
      },
      {
        "id": "p29",
        "text": "Bok Choy tapped his foot—just a little bit.",
        "translation": ""
      }
    ]
  },
  "5": {
    "episodeId": 5,
    "title": "Good Jumpers",
    "source": "official-text",
    "sourceId": "C0012334",
    "paragraphs": [
      {
        "id": "p1",
        "text": "\"Watch this!\"",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Cupcake started to run.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "She jumped over a spoon. \"Yay!\"",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Berry clapped. \"Nice jump, Cupcake!\"",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "He jumped over the spoon.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "\"Woo-hoo!\" Cupcake cheered.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "\"Now let's jump over two spoons!\"",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "They got another spoon.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "Berry jumped over them.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "Then Cupcake jumped over them. \"Yay!\"",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "Berry smiled. \"This is fun!\"",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "\"Yeah!\" Cupcake said. \"We're good jumpers!\"",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "Pickle came over.",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "\"I can jump farther.\"",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "Berry rolled his eyes. \"Who cares, Pickle?",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "We're jumping for fun.\"",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "\"Yeah, Pickle!\" Cupcake jumped again.",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "\"Who cares?\"",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "Pickle snorted. \"I can jump higher too.\"",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "Berry shrugged. \"We're just having fun, Pickle.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "Right, Cupcake?\"",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "\"Grr,\" Cupcake thought.",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "\"Pickle always has to be the best!\"",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "She frowned. \"Um . . . yeah. Fun.\"",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "Pickle folded his arms. \"I'm the best jumper.\"",
        "translation": ""
      },
      {
        "id": "p26",
        "text": "Berry sighed. \"Who cares?",
        "translation": ""
      },
      {
        "id": "p27",
        "text": "We're just having—\"",
        "translation": ""
      },
      {
        "id": "p28",
        "text": "\"I care!\" Cupcake stomped her foot. \"Agh!\"",
        "translation": ""
      }
    ]
  },
  "6": {
    "episodeId": 6,
    "title": "Too Much Bragging",
    "source": "official-text",
    "sourceId": "C0012335",
    "paragraphs": [
      {
        "id": "p1",
        "text": "\"I'm the best jumper!\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Pickle snorted. \"I'm better.\"",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "\"Grr!\" Cupcake made fists.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Popcorn and Noodles came over.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "\"What's going on?\" Popcorn asked.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "\"Pickle was bragging,\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "\"So were you!\" Pickle said.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "\"You shouldn't brag,\" Popcorn said.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "\"Well, I'm good at jumping,\" Pickle said.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "\"I run the fastest too.\"",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "\"No, you don't,\" Noodles said.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "\"I'm faster than you.\"",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "Popcorn grinned. \"And I'm even faster!\"",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "Noodles frowned. \"No, you're not!\"",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "Berry rolled his eyes.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "\"Can we just have fun?\"",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "\"I'll race you!\" Pickle ran.",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "Noodles ran.",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "Popcorn ran.",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "\"Oof!\" Popcorn's foot hit a spoon.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "The others kept running.",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "\"No fair!\" Popcorn yelled. \"I tripped!\"",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "\"Ugh,\" Berry said.",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "\"Please stop arguing!\"",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "\"Yeah!\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p26",
        "text": "\"Thank you, Cupcake,\" Berry said.",
        "translation": ""
      },
      {
        "id": "p27",
        "text": "\"It doesn't matter who's—\"",
        "translation": ""
      },
      {
        "id": "p28",
        "text": "\"Let's have a big contest instead!\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p29",
        "text": "\"Tomorrow!\"",
        "translation": ""
      }
    ]
  },
  "7": {
    "episodeId": 7,
    "title": "Getting Ready",
    "source": "official-text",
    "sourceId": "C0012336",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Everyone got ready for the contest.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Noodles jumped rope.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "Popcorn did push-ups.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Pickle did sit-ups.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "Cupcake made a scoreboard.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "\"This is silly,\" Berry said.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "\"We don't need a contest.\"",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "\"Hmph! Yes, we do!\" Cupcake got forks.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "\"It's late,\" Berry said.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "\"Let's go to sleep.\"",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "\"No way!\" Cupcake kept working.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "Berry sighed.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "He went to sleep.",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "Cupcake lined up the forks.",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "\"We can jump over these.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "Now I'll set up a racecourse.\"",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "The others came over.",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "\"Oww. This racecourse is no good,\" Popcorn said.",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "\"We'll bump into the trash can.\"",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "\"And I won't jump over forks,\" Noodles said.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "\"I might get tangled!\"",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "\"Huh?\" Pickle saw the scoreboard.",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "\"Ugh. Cupcake, why is your name on top?\"",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "They argued and argued.",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "Berry slept in his tent.",
        "translation": ""
      }
    ]
  },
  "8": {
    "episodeId": 8,
    "title": "Let's Start!",
    "source": "official-text",
    "sourceId": "C0012337",
    "paragraphs": [
      {
        "id": "p1",
        "text": "The sun came up.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "The friends were still arguing!",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "Berry went over to them.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "\"You didn't go to bed?\" he asked.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "Cupcake rubbed her eyes.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "\"We weren't tired.\"",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "Pickle yawned.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "\"Let's start the big contest.\"",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "Bok Choy was the referee.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "\"First it's jumping time,\" he said.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "Berry jumped over all the forks.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "Pickle only jumped over one. \"Hmph!\"",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "\"Oof!\" Popcorn tripped on a fork.",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "Cupcake landed on her face. \"Ouch!\"",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "Noodles didn't even try.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "\"Berry won at jumping,\" Bok Choy said.",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "\"Now it's race time.",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "One, two, three . . . Go!\"",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "Berry took off fast!",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "\"Yikes!\" Popcorn tripped.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "Noodles walked.",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "Cupcake and Pickle crashed into each other.",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "\"Berry won the big contest,\" Bok Choy said.",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "Cupcake yawned. \"Good job, Berry.\"",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "Berry shrugged. \"I'm just having fun!\"",
        "translation": ""
      }
    ]
  },
  "9": {
    "episodeId": 9,
    "title": "Paper Boats",
    "source": "official-text",
    "sourceId": "C0012338",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Cupcake wanted to play.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "But Berry was with Bok Choy.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "They were folding paper.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Cupcake frowned. \"Berry is my friend!\"",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "She went over to them.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "\"What are you doing?\" she asked.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "\"We're making boats,\" Berry said.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "\"Bok Choy is teaching me.\"",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "Cupcake sat down. \"I'll make one too.\"",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "\"Watch.\" Bok Choy made a neat fold.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "Berry's fold wasn't neat.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "Cupcake's paper ripped.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "\"Ugh!\" she said.",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "Bok Choy nodded. \"Just try again.\"",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "Berry made another fold.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "\"Uh-oh.\" This one wasn't neat either.",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "Cupcake's paper ripped again.",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "\"This isn't fun!\"",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "Berry tried again.",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "His fold still wasn't neat.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "Cupcake crushed her paper.",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "\"This stinks!\"",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "\"Ugh!\" Berry said.",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "Cupcake looked at him.",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "\"Folding paper is too hard, right?\"",
        "translation": ""
      },
      {
        "id": "p26",
        "text": "\"Yes, it's hard,\" Berry said.",
        "translation": ""
      },
      {
        "id": "p27",
        "text": "\"But you're complaining too much!\"",
        "translation": ""
      }
    ]
  },
  "10": {
    "episodeId": 10,
    "title": "A New Plan",
    "source": "official-text",
    "sourceId": "C0012339",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Bok Choy got more paper.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "\"Let's make paper airplanes instead.\"",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "\"Okay!\" Berry said.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Cupcake sighed. \"Okay.\"",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "\"Do what I do,\" Bok Choy said.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "He began to fold his paper.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "Berry worked slowly.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Cupcake worked fast.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "\"Slow down,\" Bok Choy said.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "\"Bah!\" Cupcake waved a hand.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "Finally they were done.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "Bok Choy's airplane flew far.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "Berry's airplane flew over a cup!",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "\"Yes!\" He pumped his fists.",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "\"My turn!\" Cupcake threw her plane.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "It crashed on the counter.",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "\"Grr!\" Cupcake crushed her plane.",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "Berry gasped. \"Why did you do that?\"",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "Cupcake shrugged. \"I didn't want it anymore.\"",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "Berry threw his plane again.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "Cupcake watched.",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "She bit her lip.",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "Then she walked over to Berry.",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "\"Um, Berry?\" Cupcake said sweetly.",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "\"Can I borrow your paper airplane?\"",
        "translation": ""
      }
    ]
  },
  "11": {
    "episodeId": 11,
    "title": "One More Throw",
    "source": "official-text",
    "sourceId": "C0012340",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Berry held his airplane close.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "\"I don't know, Cupcake . . .\"",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "He looked at her crushed airplane.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Cupcake shrugged. \"Mine didn't work.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "I won't crush yours.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "You're my friend!\"",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "Berry sighed. \"Okay.\"",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "\"Yay!\" Cupcake grabbed his airplane. \"Thanks!\"",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "\"Be careful,\" Bok Choy said.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "\"Okay!\" Cupcake threw the airplane.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "\"Woo-hoo!\" She threw it again.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "It landed near the counter's edge!",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "Berry gulped. \"Be careful!\"",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "\"This is fun!\" Cupcake threw the airplane again.",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "It went over the wet sink.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "Berry frowned. \"That's enough!",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "It's my turn now!\"",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "\"Not yet,\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "\"I want two more turns!\"",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "\"You had enough turns!\" Berry said.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "\"One more throw!\" Cupcake threw the airplane again.",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "It went in the sink!",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "They jumped in to get it.",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "Berry gasped. \"My airplane is all wet!\"",
        "translation": ""
      }
    ]
  },
  "12": {
    "episodeId": 12,
    "title": "Still Friends",
    "source": "official-text",
    "sourceId": "C0012341",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Berry wiped away some tears.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "\"You ruined my airplane, Cupcake!\"",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "He left the sink.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Bok Choy shook his head.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "Then he left.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Cupcake felt awful.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "Suddenly the wet airplane flopped open.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Cupcake looked at it closely.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "She unfolded it some more.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "Then she folded it back.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "\"Hmm,\" Cupcake said.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "\"I can learn to fold paper.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "Maybe it's not hard after all.\"",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "She got a sheet of paper.",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "This time she worked very slowly.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "Berry was sitting by his tent.",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "He was still mad.",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "Bonk! A paper airplane hit him!",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "He saw words on it: Open me .",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "Berry opened the airplane.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "Dear Berry,",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "I'm sorry I ruined your airplane.",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "You can have this one.",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "Love, Cupcake",
        "translation": ""
      },
      {
        "id": "p25",
        "text": "Berry looked down.",
        "translation": ""
      },
      {
        "id": "p26",
        "text": "He saw Cupcake.",
        "translation": ""
      },
      {
        "id": "p27",
        "text": "Her eyes were wide. \"Are we still friends?\"",
        "translation": ""
      },
      {
        "id": "p28",
        "text": "Berry smiled. \"Best friends!\"",
        "translation": ""
      }
    ]
  }
}
