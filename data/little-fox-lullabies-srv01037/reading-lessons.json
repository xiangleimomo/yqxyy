    "source": "official-text",
    "sourceId": "C0000254",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Go to sleep, now, dear love, 'neath roses above.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Sweet blossoms white and red shall bloom by thy bed.",
