    "title": "Sleep, Baby, Sleep",
    "source": "official-text",
    "sourceId": "C0000125",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Sleep, baby, sleep.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Your father tends the sheep.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "Your mother shakes the Dream Land tree.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Down falls a little dream for thee.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "Sleep, baby, sleep.",
        "translation": ""
      }
    ]
  },
  "3": {
    "episodeId": 3,
    "title": "Star Light, Star Bright",
    "source": "official-text",
    "sourceId": "C0005055",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Star light, star bright,",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "The first star I see tonight.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "I wish I may, I wish I might,",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Have the wish I wish tonight.",
        "translation": ""
      }
    ]
