    "paragraphs": [
      {
        "id": "p1",
        "text": "Rock-a-bye, baby,",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "On the treetop.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "When the wind blows,",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "The cradle will rock.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "When the bough breaks,",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "The cradle will fall.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "And down will come baby,",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Cradle and all.",
        "translation": ""
      }
    ]
  },
  "2": {
