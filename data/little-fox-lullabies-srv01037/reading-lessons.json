  "7": {
    "episodeId": 7,
    "title": "Mozart's Lullaby",
    "source": "official-text",
    "sourceId": "C0000551",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Sleep, little one, go to sleep,",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "So peaceful the birds and the sheep,",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "Quiet are meadows and trees,",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Even the buzz of the bees,",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "The silvery moonbeams so bright,",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Down through the window give light,",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "O’er you the moonbeams will creep,",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Sleep, little one, go to sleep.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "Good night, Good night.",
        "translation": ""
      }
    ]
  },
  "8": {
    "episodeId": 8,
    "title": "The Riddle Song",
    "source": "official-text",
    "sourceId": "C0003615",
    "paragraphs": [
      {
        "id": "p1",
        "text": "I gave my love a cherry that had no stone.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "I gave my love a chicken that had no bone.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "I told my love a story that had no end.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "I gave my love a baby with no crying.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "How can there be a cherry that has no stone?",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "And how can there be a chicken that has no bone?",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "And how can there be a story that has no end?",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "And how can there be a baby with no crying?",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "A cherry when it's blooming, it has no stone.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "A chicken in an eggshell, it has no bone.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "The story of I love you, it has no end.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "A baby when it's sleeping is not crying.",
        "translation": ""
      }
    ]
  },
