  "4": {
    "episodeId": 4,
    "title": "Hush, Little Baby",
    "source": "official-text",
    "sourceId": "C0000118",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Hush, little baby, don't say a word.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Mama's going to buy you a mockingbird.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "And if that mockingbird don't sing,",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Mama's going to buy you a diamond ring.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "And if that diamond ring turns brass,",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Mama's going to buy you a looking glass.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "And if that looking glass gets broke,",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Mama's going to buy you a billy goat.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "And if that billy goat won't pull,",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "Mama's going to buy you a cart and bull.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "And if that cart and bull turn over,",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "Mama's going to buy you a dog named Rover.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "And if that dog named Rover won't bark,",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "Mama's going to buy you a horse and cart.",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "And if that horse and cart fall down,",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "You'll be the sweetest little baby in town.",
        "translation": ""
      }
    ]
  },
