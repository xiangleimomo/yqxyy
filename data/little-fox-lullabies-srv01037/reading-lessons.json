  "13": {
    "episodeId": 13,
    "title": "All Through the Night",
    "source": "official-text",
    "sourceId": "C0000203",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Sleep, my child, and peace attend thee,",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "All through the night;",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "Guardian angels God will send thee,",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "All through the night;",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "Soft the drowsy hours are creeping,",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Hill and vale in slumber sleeping,",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "I my loving vigil keeping,",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "All through the night.",
        "translation": ""
      }
    ]
  },
