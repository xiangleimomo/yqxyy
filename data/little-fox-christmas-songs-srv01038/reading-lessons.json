  "10": {
    "episodeId": 10,
    "title": "Away in a Manger",
    "source": "official-text",
    "sourceId": "C0000805",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Away in a manger,",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "No crib for His bed,",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "The little Lord Jesus,",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Laid down His sweet head.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "The stars in the sky,",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Looked down where He lay,",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "The little Lord Jesus,",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Asleep on the hay.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "Be near me Lord Jesus,",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "I ask you to stay,",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "Beside me forever,",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "And guide me I pray.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "Bless all the dear children,",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "With your tender care,",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "And take us to heaven,",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "To be with you there.",
        "translation": ""
      }
    ]
  },
