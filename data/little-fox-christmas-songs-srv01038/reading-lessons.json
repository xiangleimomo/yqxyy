  "5": {
    "episodeId": 5,
    "title": "Deck the Halls",
    "source": "official-text",
    "sourceId": "C0000033",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Deck the halls with boughs of holly.",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Fa-la-la-la, la-la-la-la.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "'Tis the season to be jolly.",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "Fa-la-la-la, la-la-la-la.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "Don we now our gay apparrel.",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Fa-la-la, la-la-la, la-la-la.",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "Troll the ancient Yuletide carol.",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Fa-la-la-la, la-la-la-la.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "See the blazing Yule before us.",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "Fa-la-la-la, la-la-la-la.",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "Strike the harp and join the chorus.",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "Fa-la-la-la, la-la-la-la.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "Follow me in merry measure.",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "Fa-la-la, la-la-la, la-la-la.",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "While I tell of Yuletide treasure.",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "Fa-la-la-la, la-la-la-la.",
        "translation": ""
      }
    ]
