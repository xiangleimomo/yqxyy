  "7": {
    "episodeId": 7,
    "title": "Jolly Old St. Nicholas",
    "source": "official-text",
    "sourceId": "C0005972",
    "paragraphs": [
      {
        "id": "p1",
        "text": "Jolly Old Saint Nicholas,",
        "translation": ""
      },
      {
        "id": "p2",
        "text": "Lean your ear this way.",
        "translation": ""
      },
      {
        "id": "p3",
        "text": "Don't you tell a single soul",
        "translation": ""
      },
      {
        "id": "p4",
        "text": "What I'm going to say.",
        "translation": ""
      },
      {
        "id": "p5",
        "text": "Christmas Eve is coming soon,",
        "translation": ""
      },
      {
        "id": "p6",
        "text": "Now my dear old man,",
        "translation": ""
      },
      {
        "id": "p7",
        "text": "Whisper what you'll bring to me,",
        "translation": ""
      },
      {
        "id": "p8",
        "text": "Tell me if you can.",
        "translation": ""
      },
      {
        "id": "p9",
        "text": "When the clock is striking twelve,",
        "translation": ""
      },
      {
        "id": "p10",
        "text": "When I'm fast asleep,",
        "translation": ""
      },
      {
        "id": "p11",
        "text": "Down the chimney with your pack",
        "translation": ""
      },
      {
        "id": "p12",
        "text": "Softly you will creep.",
        "translation": ""
      },
      {
        "id": "p13",
        "text": "All the stockings you will find",
        "translation": ""
      },
      {
        "id": "p14",
        "text": "Hanging in a row,",
        "translation": ""
      },
      {
        "id": "p15",
        "text": "Mine will be the shortest one,",
        "translation": ""
      },
      {
        "id": "p16",
        "text": "You'll be sure to know.",
        "translation": ""
      },
      {
        "id": "p17",
        "text": "Johnny wants a pair of skates,",
        "translation": ""
      },
      {
        "id": "p18",
        "text": "Susy wants a sled,",
        "translation": ""
      },
      {
        "id": "p19",
        "text": "Nelly wants a storybook,",
        "translation": ""
      },
      {
        "id": "p20",
        "text": "One she hasn't read.",
        "translation": ""
      },
      {
        "id": "p21",
        "text": "As for me, I hardly know,",
        "translation": ""
      },
      {
        "id": "p22",
        "text": "So I'll go to rest.",
        "translation": ""
      },
      {
        "id": "p23",
        "text": "Choose for me, dear Santa Claus,",
        "translation": ""
      },
      {
        "id": "p24",
        "text": "What you think is best.",
        "translation": ""
      }
    ]
  },
