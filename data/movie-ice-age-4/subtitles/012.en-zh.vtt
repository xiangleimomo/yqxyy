00:02:45.786 --> 00:02:46.621
Hmm.

00:02:46.704 --> 00:02:47.955
(gasps)

00:02:50.416 --> 00:02:51.584
Aha.

00:02:54.795 --> 00:02:56.714
(sighs)

00:02:56.797 --> 00:02:58.090
(laughing hysterically)

00:02:58.716 --> 00:02:59.675
(gasps)

00:03:01.260 --> 00:03:02.094
(screams)

00:03:02.970 --> 00:03:03.888
(gasps)

00:03:04.680 --> 00:03:06.974
(laughing hysterically)

00:03:07.934 --> 00:03:09.393
(screams)

00:03:10.561 --> 00:03:12.063
(laughing hysterically)

00:03:16.525 --> 00:03:19.237
(laughing hysterically)

00:03:22.448 --> 00:03:23.449
(gasps)

00:03:23.532 --> 00:03:24.533
(shrieks)

00:03:28.287 --> 00:03:29.121
(crowd gasps)
不

00:03:29.205 --> 00:03:30.039
